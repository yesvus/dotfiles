# Hand the client's terminal back its own colors on logout. ~/.zshrc forces the
# One Dark palette via OSC escapes, which persist in the emulator after the
# session ends, so without this an SSH client would stay One Dark forever.
if [[ -r "$HOME/.config/shell/onedark-term.sh" ]]; then
  emulate sh -c 'ONEDARK_LIB_ONLY=1 . "$HOME/.config/shell/onedark-term.sh" >/dev/null 2>&1; onedark_reset_palette 2>/dev/null'
fi
