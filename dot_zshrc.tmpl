

# Added by Antigravity CLI installer
export PATH="$HOME/.local/bin:$PATH"

# Lightweight interactive setup: built-in completion and persistent history.
fpath+=/usr/share/zsh/plugins/zsh-completions/src
autoload -Uz compinit
compinit

HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000

setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS
setopt SHARE_HISTORY
setopt AUTO_CD

# --- Word navigation/deletion (Ctrl+Left/Right/Backspace/Delete) ---
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word
bindkey '^H' backward-delete-word     # Ctrl+Backspace
bindkey '^[[3;5~' kill-word           # Ctrl+Delete

# --- Autosuggestions (ghost text) ---
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
bindkey '^ ' autosuggest-accept   # Ctrl+Space to accept ghost suggestion

# --- fzf keybindings + fuzzy completion (Ctrl+R, Ctrl+T, Alt+C) ---
source /usr/share/fzf/key-bindings.zsh
source /usr/share/fzf/completion.zsh

# --- Syntax highlighting (must be sourced LAST) ---
source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

PROMPT='%F{green}%n@%m%f %F{blue}%~%f %# '
export COLORTERM="truecolor"
