#!/usr/bin/env bash
# Install the "One Dark" Terminal.app profile and set it as default/startup.
# Idempotent; chezmoi re-runs this only when OneDark.terminal's contents change
# (hash embedded below forces a rerun trigger).
# contents hash: {{ include "private_dot_terminal_app/OneDark.terminal" | sha256sum }}
set -euo pipefail

TERM_FILE="{{ .chezmoi.sourceDir }}/private_dot_terminal_app/OneDark.terminal"
PREFS="$HOME/Library/Preferences/com.apple.Terminal.plist"

if [ "{{ .chezmoi.os }}" != "darwin" ]; then
  echo "not macOS, skipping Terminal.app setup"
  exit 0
fi
[ -f "$TERM_FILE" ] || { echo "missing $TERM_FILE"; exit 1; }

python3 - "$TERM_FILE" "$PREFS" << 'PYEOF'
import plistlib, subprocess, sys, os

term_file, prefs_path = sys.argv[1], sys.argv[2]

with open(term_file, "rb") as f:
    onedark = plistlib.load(f)

if not os.path.exists(prefs_path):
    prefs = {}
else:
    xml_tmp = "/tmp/_term_prefs_export.xml"
    subprocess.run(["plutil", "-convert", "xml1", "-o", xml_tmp, prefs_path], check=True)
    with open(xml_tmp, "rb") as f:
        prefs = plistlib.load(f)
    os.remove(xml_tmp)

settings = prefs.get("Window Settings", {})
settings["One Dark"] = onedark
prefs["Window Settings"] = settings
prefs["Default Window Settings"] = "One Dark"
prefs["Startup Window Settings"] = "One Dark"

xml_new = "/tmp/_term_prefs_new.xml"
with open(xml_new, "wb") as f:
    plistlib.dump(prefs, f)

os.makedirs(os.path.dirname(prefs_path), exist_ok=True)
subprocess.run(["plutil", "-convert", "binary1", "-o", prefs_path, xml_new], check=True)
os.remove(xml_new)
print(f"Installed 'One Dark' Terminal.app profile as default at {prefs_path}")
PYEOF

echo "NOTE: fully quit Terminal.app (Cmd+Q) if it's currently running, so it"
echo "doesn't overwrite this change with its cached in-memory preferences."
