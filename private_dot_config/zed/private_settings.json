{
  "cli_default_open_behavior": "existing_window",
  "ui_font_weight": 500.0,
  "buffer_line_height": "standard",
  "icon_theme": "VSCode Icons for Zed (Dark)",
  "git_panel": {
    "tree_view": true,
    "dock": "left"
  },
  "agent": {
    "sandbox_permissions": {
      "allow_unsandboxed": true
    },
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.6-luna",
      "enable_thinking": true,
      "effort": "medium"
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "base_keymap": "VSCode",
  "project_panel": {
    "dock": "left"
  },
  "ui_font_family": "Noto Sans",
  "ui_font_size": 14.0,
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_size": 14.0,
  "buffer_font_weight": 700.0,
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font Mono",
    "font_size": 15,
    "font_weight": 700
  },
  "minimap": {
    "show": "always"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    },
    "github-copilot-cli": {
      "type": "registry"
    }
  },
  "theme": "Tokyo Night Storm",
  "soft_wrap": "editor_width"
}
