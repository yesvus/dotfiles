{
    "layer": "top",
    "position": "top",
    // Tall enough to fit the 2-row performance group; other single-line
    // modules just center vertically within the extra room.
    "height": 26,
    "spacing": 0,

    "modules-left": ["custom/archmenu", "custom/launcher", "group/workspacesview"],
    "modules-center": ["clock"],
    "modules-right": [
        "group/claude",
        "group/performance",
        "group/connectivity",
        "pulseaudio",
        "group/lighting",
        "custom/battery"
    ],

    // Workspace view icon + the workspace/window indicator, merged into one
    // visual block.
    "group/workspacesview": {
        "orientation": "horizontal",
        "modules": ["custom/overview", "custom/workspaces"]
    },
    // Event-driven workspace+window indicator (niri-workspaces-rs by
    // 1jehuang -- github.com/1jehuang/niri-workspaces-rs). Each window is
    // its own colored bar, app-aware; replaces the separate niri/workspaces
    // + windowdots-script combo with one properly integrated view.
    "custom/workspaces": {
        "exec": "~/.config/waybar/niri-workspaces",
        "return-type": "json",
        "format": "{}",
        "tooltip": false
    },
    // macOS Apple-menu equivalent: click the Arch logo for a system menu.
    "custom/archmenu": {
        "format": "",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "/home/yesvus/.config/waybar/arch-menu.xml",
        "menu-actions": {
            "about": "foot --app-id=arch-about-float --window-size-chars=100x40 -e sh -c 'fastfetch; echo; echo \"Press any key to close...\"; read -n1 -s'",
            "settings": "xfce4-settings-manager",
            "updates": "foot --app-id=arch-about-float --window-size-chars=100x40 -e sh -c 'checkupdates || echo \"System is up to date.\"; echo; echo \"Press any key to close...\"; read -n1 -s'",
            "lock": "swaylock -f -c 282c34",
            "logout": "niri msg action quit",
            "sleep": "systemctl suspend",
            "reboot": "systemctl reboot",
            "shutdown": "systemctl poweroff"
        }
    },
    // Mouse-friendly overview launcher (niri's overview shortcut is Mod+O;
    // this replaces the removed top-left hot corner as a click target).
    "custom/overview": {
        "format": "󰀻",
        "tooltip": false,
        "on-click": "niri msg action toggle-overview"
    },
    "custom/launcher": {
        "format": "",
        "tooltip": false,
        "on-click": "fuzzel"
    },
    // Two columns, two rows: cpu/memory stacked in one column, disk/temp in
    // the other, so the whole group stays narrow instead of running wide.
    "group/performance": {
        "orientation": "horizontal",
        "modules": ["group/perf-col1", "group/perf-col2"]
    },
    "group/perf-col1": {
        "orientation": "vertical",
        "modules": ["cpu", "memory"]
    },
    "group/perf-col2": {
        "orientation": "vertical",
        "modules": ["disk", "temperature"]
    },
    "cpu": {
        "interval": 2,
        "format": "󰌓 {usage}%",
        "tooltip": false,
        "on-click": "foot --app-id=btop-float -e btop"
    },
    "memory": {
        "format": "󰍛 {percentage}%",
        "tooltip": false,
        "on-click": "foot --app-id=btop-float -e btop"
    },
    "disk": {
        // Root is backed by the machine's NVMe drive; show used space.
        "path": "/",
        "interval": 60,
        "format": "󰋊 {percentage_used}%",
        "tooltip": false,
        "on-click": "foot --app-id=btop-float -e btop"
    },
    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon4/temp1_input",
        "critical-threshold": 90,
        "format": "󰔏 {temperatureC}°",
        "tooltip": false,
        "on-click": "foot --app-id=btop-float -e btop"
    },

    // Claude Code rate-limit budgets, stacked like perf-col: 5h over 7d.
    // Each row is itself two modules (percentage, reset countdown) because
    // waybar's custom-module JSON text doesn't render Pango markup, so
    // dimming just the countdown needs its own CSS class, not inline markup.
    // Values come from a cache file that ~/.claude/statusline-command.sh
    // writes on every active session -- there's no standalone command to
    // query current usage, so this just reflects the last session update.
    "group/claude": {
        "orientation": "vertical",
        "modules": ["group/claude-5h", "group/claude-7d"]
    },
    "group/claude-5h": {
        "orientation": "horizontal",
        "modules": ["custom/claude-5h-pct", "custom/claude-5h-reset"]
    },
    "group/claude-7d": {
        "orientation": "horizontal",
        "modules": ["custom/claude-7d-pct", "custom/claude-7d-reset"]
    },
    "custom/claude-5h-pct": {
        "exec": "waybar-claude-limits 5h pct",
        "interval": 5,
        "return-type": "json",
        "tooltip": false,
        "on-click": "foot -D $HOME -e claude"
    },
    "custom/claude-5h-reset": {
        "exec": "waybar-claude-limits 5h reset",
        "interval": 5,
        "return-type": "json",
        "tooltip": false,
        "on-click": "foot -D $HOME -e claude"
    },
    "custom/claude-7d-pct": {
        "exec": "waybar-claude-limits 7d pct",
        "interval": 5,
        "return-type": "json",
        "tooltip": false,
        "on-click": "foot -D $HOME -e claude"
    },
    "custom/claude-7d-reset": {
        "exec": "waybar-claude-limits 7d reset",
        "interval": 5,
        "return-type": "json",
        "tooltip": false,
        "on-click": "foot -D $HOME -e claude"
    },

    // Network icon + tray (nm-applet's own network entry, etc.) sharing one
    // block, since they're both connectivity-related.
    "group/connectivity": {
        "orientation": "horizontal",
        "modules": ["network", "tray"]
    },
    // No "interface" pinned: waybar follows the default route, so this
    // switches automatically between the wifi and ethernet formats below
    // depending on which is actually up. Icon only -- hover for details.
    "network": {
        "format-wifi": "󰖩",
        "format-ethernet": "",
        "format-disconnected": "󰖪",
        "tooltip": false,
        "on-click": "nm-connection-editor"
    },
    "tray": {
        "icon-size": 15,
        "spacing": 8
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "tooltip": false,
        // Waybar's own scroll step, separate from the wpctl keybinds in sway
        // config (both now move volume by 5%, not the 1% default).
        "scroll-step": 5,
        "on-click": "pavucontrol"
    },
    // Night light + brightness share one block: both are "light" controls.
    "group/lighting": {
        "orientation": "horizontal",
        "modules": ["custom/nightlight", "custom/brightness-ddc"]
    },
    "custom/brightness-ddc": {
        "exec": "sway-brightness-ddc show",
        "interval": 1,
        "format": "󰃟 {}%",
        "tooltip": false,
        "on-click": "sway-brightness-ddc bump +5",
        "on-click-right": "sway-brightness-ddc bump -5",
        "on-scroll-up": "sway-brightness-ddc bump +5",
        "on-scroll-down": "sway-brightness-ddc bump -5"
    },
    // Static button: click toggles wlsunset's forced day/night state (same
    // USR1 signal as $mod+Shift+n).
    "custom/nightlight": {
        "format": "󰖔",
        "tooltip": false,
        "on-click": "pkill -USR1 -x wlsunset"
    },
    // Custom instead of the built-in battery module: hide-when-empty lets
    // waybar-battery collapse this widget away entirely while on AC, instead
    // of always showing a percentage that isn't relevant when plugged in.
    "custom/battery": {
        "exec": "waybar-battery",
        "interval": 30,
        "return-type": "json",
        "tooltip": false,
        "hide-when-empty": true
    },

    "clock": {
        "interval": 1,
        "format": "{:%a %b %d, %H:%M:%S}",
        "tooltip": false
    }
}
