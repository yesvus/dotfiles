# Ghostty Configuration

# Font
font-size = 10.5
font-thicken = true

# Window padding
window-padding-x = 5
window-padding-y = 5
window-padding-balance = true

# Disable GTK CSD headerbar (recommended for tiling WMs like Niri)
window-decoration = false

# Theme
# Dark: exact One Dark palette from jelly's Alacritty config (~/.config/alacritty/alacritty.toml)
# Light: Ghostty's built-in preset (jelly has no light variant to match)
theme = light:Atom One Light,dark:Atom One Dark

# Skip the close-window confirmation prompt entirely (no dialog to tab through)
confirm-close-surface = false

# Reuse a single running ghostty process for new windows -> near-instant launch
gtk-single-instance = true

# Niri handles all tiling/window management, so kill ghostty's native
# split and tab features (and their keybinds) to avoid conflicts.
window-show-tab-bar = never

keybind = ctrl+shift+tab=unbind
keybind = ctrl+tab=unbind
keybind = ctrl+shift+w=unbind
keybind = ctrl+shift+t=unbind
keybind = ctrl+shift+arrow_left=unbind
keybind = ctrl+shift+arrow_right=unbind
