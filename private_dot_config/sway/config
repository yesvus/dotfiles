# >>> jcode desktop setup (managed) >>>
### autostart
exec mako
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec nm-applet --indicator
# Tray icon with a click-to-open device/volume popover (waybar's own
# pulseaudio module is just a text readout, not a menu).
exec pasystray

### night light
# 6500K daytime, 4000K from 20:00 to 07:00, with 30-minute transitions.
exec_always "pkill -x wlsunset; wlsunset -S 07:00 -s 20:00 -T 6500 -t 4000 -d 1800"
# Cycle: forced daytime -> forced night -> automatic schedule.
bindsym $mod+Shift+n exec pkill -USR1 -x wlsunset

### idle and lock
set $lock swaylock -f -c 282c34
exec swayidle -w \
    timeout 3600 '$lock; swaymsg "output * power off"' \
        resume    'swaymsg "output * power on"'
bindsym $mod+Shift+x exec $lock

### clamshell mode
# External monitor present: close lid -> disable eDP-1 and let Sway migrate its
# workspaces. No external monitor: lock and suspend. Hotplug watcher prevents a
# black/display-less session if HDMI is unplugged while the lid remains closed.
bindswitch --locked --reload lid:on  exec sway-clamshell close
bindswitch --locked --reload lid:off exec sway-clamshell open
exec_always sway-clamshell-watch

# This is an always-on deck workstation. Block every sleep operation while Sway
# is running, including manual `systemctl suspend/hibernate` and lid handling.
exec_always sway-no-sleep

### touchpad
input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
    middle_emulation enabled
    accel_profile adaptive
}

### screenshots (needs grim + slurp + wl-clipboard)
# region to clipboard
bindsym Print             exec grim -g "$(slurp)" - | wl-copy --type image/png
# whole screen to ~/Pictures
bindsym Shift+Print       exec grim ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png
# region to file
bindsym $mod+Print        exec grim -g "$(slurp)" ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png

# NOTE: volume and brightness keys are already bound in the stock config above.
# Re-binding them here would be a duplicate, which sway reports as a config
# error, so they are deliberately not repeated.

### looks
# Full title bars (not just a border): gives a drag handle, so the machine
# stays usable with just a mouse.
#
# NOTE on the close button: sway's own SSD titlebar (this "normal" border
# mode) has no visual close/min/max button at all -- that's a sway/wlroots
# limitation, not a config gap. GTK/Adwaita apps under Wayland normally draw
# their own CSD (client-side decoration) with a real close button and
# already look right; sway's titlebar only kicks in for windows that don't
# draw their own (mostly Xwayland apps). As the closest mouse-only
# equivalent, middle-click on any titlebar closes that window (see bindsym
# below); $mod+q still works too.
# Back to a plain pixel border, no title bar -- the "GTK-style close button
# with a text title bar" experiment didn't land well; sway's own titlebar
# can't draw a close button anyway (see git history if reviving this).
default_border pixel 1
default_floating_border pixel 1
gaps inner 0
gaps outer 0
# Hide the accent border/corners when a single window has the workspace to
# itself (with gaps at 0, there's nothing to distinguish it from) -- it only
# shows once there's a second window to tell apart from.
smart_borders on
# Selenized-black gray, matching the bar/background instead of the old
# Selenized-dark blue.
client.focused          #4695f7 #181818 #dedede #4695f7 #4695f7
client.focused_inactive #3b3b3b #252525 #b9b9b9 #3b3b3b #3b3b3b
client.unfocused        #3b3b3b #181818 #777777 #3b3b3b #3b3b3b

### system-wide dark mode
# Linux has no single theme switch, so dark is asserted on two channels that
# together cover every toolkit on this machine:
#   1. dconf (below) -> read by the xdg-desktop-portal-gtk backend, which
#      publishes org.freedesktop.appearance/color-scheme on D-Bus. GTK4 andi
#      libadwaita, Firefox, Chromium and Electron follow this and nothing else.
#      GTK3 on Wayland also reads these keys through its gsettings backend,
#      and they outrank settings.ini, so the two must agree.
#   2. ~/.config/gtk-{3,4}.0/settings.ini -> the fallback GTK reads directly at
#      startup, covering the case where dconf or the portal is unavailable.
# Adwaita's dark variant is built into GTK, so no theme package is needed.
# gtk-theme stays "Adwaita", NOT "Adwaita-dark": the -dark suffix is a GTK4
# theme name, and GTK3 has no such theme on disk, so setting it makes GTK3
# silently fall back to light. Dark is requested via prefer-dark instead,
# which both GTK3 and GTK4 understand.
# GTK_THEME is deliberately not exported: it is a hard override that outranks
# the portal and would stop apps from ever following a light/dark switch.
set $gnome-schema org.gnome.desktop.interface
exec_always {
    gsettings set $gnome-schema color-scheme 'prefer-dark'
    gsettings set $gnome-schema gtk-theme 'Adwaita'
    gsettings set $gnome-schema icon-theme 'Adwaita'
    gsettings set $gnome-schema cursor-theme 'breeze_cursors'
    gsettings reset $gnome-schema cursor-size
    gsettings set $gnome-schema font-antialiasing 'rgba'
    gsettings set $gnome-schema font-hinting 'full'
    gsettings set $gnome-schema font-rgba-order 'rgb'
}
seat seat0 xcursor_theme breeze_cursors
